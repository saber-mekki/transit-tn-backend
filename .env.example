# ─── DATABASE ────────────────────────────────────
# Local PostgreSQL:
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/transit_tn"

# Supabase (cloud option):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Railway / Render (they give you this URL automatically):
# DATABASE_URL="postgresql://..."

# ─── JWT (required) ──────────────────────────────
# Signs login tokens. In production the server refuses to start without it
# or if it is shorter than 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# ─── SERVER ──────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── OPTIONAL FEATURES ───────────────────────────
# Emails (verification and password reset codes)
RESEND_API_KEY=
# Banner image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# AI assistant (/api/ai)
GROQ_API_KEY=
# Recipient of contact form messages
GMAIL_USER=
